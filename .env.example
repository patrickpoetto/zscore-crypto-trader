# ============================================
# ZSCORE CRYPTO TRADER - ENVIRONMENT CONFIG
# ============================================
# Copy this file to `.env` and fill in your own credentials.
# NEVER commit your real .env file.

# Trading mode: 'DEX' or 'CEX' (Binance)
TRADING_MODE=CEX

# ============================================
# API KEYS - CEX (Binance)
# ============================================
BINANCE_API_KEY=
BINANCE_API_SECRET=
USE_TESTNET=true

# ============================================
# API KEYS - DEX (Alchemy + Wallet)
# ============================================
ALCHEMY_API_KEY=
PRIVATE_KEY=
WALLET_ADDRESS=
NETWORK=sepolia

# ============================================
# API KEYS - Hyperliquid
# ============================================
HYPERLIQUID_USE_TESTNET=true
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=

# ============================================
# TRADING - PAIRS AND QUANTITIES
# ============================================
# Comma-separated pairs (Binance format: BTCUSDT,ETHUSDT,BNBUSDT)
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT

# Quantity per pair, comma-separated (base asset units)
# Used only if MAX_POSITION_PERCENT=0 (fixed-quantity mode)
QUANTITY_PER_PAIR=0.001,0.001,0.001
QUANTITY=0.001

# ============================================
# ACCUMULATION MODE
# ============================================
# Max % of capital per pair (0 = disabled, uses fixed quantity)
MAX_POSITION_PERCENT=20.0

# Incremental accumulation amount
# Option 1: fixed USDT value (priority if > 0)
ACCUMULATION_AMOUNT_USD=0

# Option 2: % of total capital (used if ACCUMULATION_AMOUNT_USD=0)
ACCUMULATION_PERCENT=2.0

# ============================================
# PARTIAL TAKE PROFIT
# ============================================
ENABLE_PARTIAL_TAKE_PROFIT=true
TAKE_PROFIT_PERCENT=5.0
PARTIAL_SELL_PERCENT=50.0

# ============================================
# TIMEFRAME AND INTERVALS
# ============================================
# OHLC candle interval (1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d, 3d, 1w, 1M)
TIMEFRAME=5m

# Seconds between trading cycles
CYCLE_INTERVAL=30

# Report every N cycles
REPORT_INTERVAL=10

# ============================================
# TRADING FEES
# ============================================
TRADING_FEE_PERCENT=0.1
GAS_FEE_ESTIMATE=0.0045

# ============================================
# STRATEGY - BASE PARAMETERS
# ============================================
Z_SCORE_THRESHOLD=2.0
LOOKBACK_PERIOD=20
MA_PERIOD=10

# ============================================
# STRATEGY - FILTERS
# ============================================
USE_PREV_ZSCORE_FILTER=true
USE_MOMENTUM_FILTER=true
USE_MA_FILTER=true
MIN_CONFIDENCE=0.5
